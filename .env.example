# Alkanes Documentation & Governance Platform
# Copy to .env and fill in values

# ============================================
# Database (Cloud SQL for production)
# ============================================
# Local development (uses port 5433 to avoid conflicts):
# DATABASE_URL="postgresql://alkanes:alkanes_dev_password@localhost:5433/alkanes_docs"

# Cloud SQL (production):
# DATABASE_URL="postgresql://alkanes:<password>@/alkanes_docs?host=/cloudsql/<project>:<region>:<instance>"
DATABASE_URL="postgresql://alkanes:alkanes_dev_password@localhost:5433/alkanes_docs"

# ============================================
# Redis (Cloud Memorystore for production)
# ============================================
# Local development (uses port 6380 to avoid conflicts):
# REDIS_URL="redis://localhost:6380"

# Cloud Memorystore (production):
# REDIS_URL="redis://10.x.x.x:6379"
REDIS_URL="redis://localhost:6380"

# ============================================
# Network Configuration
# ============================================
# Options: mainnet, testnet, signet, regtest
NEXT_PUBLIC_NETWORK="mainnet"

# ============================================
# Sandshrew API (for alkane data)
# ============================================
SANDSHREW_API_URL="https://mainnet.sandshrew.io/v4/wrlckwrld"

# ============================================
# Optional: IPFS for vote storage
# ============================================
# IPFS_API_URL="https://ipfs.infura.io:5001"
# IPFS_PROJECT_ID=""
# IPFS_PROJECT_SECRET=""

# Operator token for the site's administrative routes
# (POST/PUT /api/forum/categories, moderator overrides on thread and post
# moderation). Must be at least 32 characters; with it unset those routes
# answer 503 and are unusable rather than open. Generate with:
#   openssl rand -hex 32
FORUM_ADMIN_TOKEN=

# --- Builder registry ------------------------------------------------------
# X (Twitter) OAuth 2.0. The routes at app/api/auth/x/* are STUBS: they answer
# 501 until implemented. Creating the X app is an operator step — see the W5
# report's X operator checklist. Note the X free tier is gone; API access is
# pay-per-use and needs credits before the first call.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
# Optional; defaults to "users.read tweet.read". Do NOT add offline.access —
# the registry reads the identity once and never acts on the account.
X_OAUTH_SCOPES=
# HMAC key for the registry's session cookie. At least 32 characters.
# Unset means registration and rotation answer 503, not that they are open.
#   openssl rand -hex 32
REGISTRY_SESSION_SECRET=
